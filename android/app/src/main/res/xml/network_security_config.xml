<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- إعداد عام: يسمح بالـ HTTP (cleartext) أثناء التطوير -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
